# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...            # server only — used by cron + push

# Anthropic (server only — never exposed to the client)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Web Push — generate with: npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=B...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:you@example.com

# Vercel Cron protection (Vercel sets Authorization: Bearer $CRON_SECRET)
CRON_SECRET=some-long-random-string

# Optional speed bump for the two AI endpoints (the app has no login by design).
# If set, the app sends it as a header and the server refuses requests without it.
# NEXT_PUBLIC_APP_KEY=another-long-random-string
